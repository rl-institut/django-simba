#: core/templates/core/help.html:642
#, fuzzy, python-format
#| msgid ""
#| "\n"
#| "          Ihre Szenarien können Sie über das <a "
#| "href=\"%(dashboard_url)s\" class=\"text-blue-600 hover:"
#| "underline\">Szenario-Dashboard</a> exportieren.\n"
